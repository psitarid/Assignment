      Object {
	$PropName		"MaskObject"
	$ObjectID		28
	$ClassName		"Simulink.Mask"
	Type			"Model of an SMF "
	Description		"This model solves the NLSE for pulse propagation in an optical fiber using the SSF (Split Step Fourier)"
	" method \nThe following effects are included: group velocity dispersion (GVD), higher order dispersion, loss, and sel"
	"f-phase modulation (gamma)"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  12
	  Object {
	    $ObjectID		    29
	    Type		    "edit"
	    Name		    "nt"
	    Prompt		    "Number of FFT"
	    Value		    "1024"
	  }
	  Object {
	    $ObjectID		    30
	    Type		    "edit"
	    Name		    "dt"
	    Prompt		    "Time step (ps)"
	    Value		    "dt"
	  }
	  Object {
	    $ObjectID		    31
	    Type		    "edit"
	    Name		    "dz"
	    Prompt		    "Distance step (km)"
	    Value		    "0.01"
	  }
	  Object {
	    $ObjectID		    32
	    Type		    "edit"
	    Name		    "nz"
	    Prompt		    "Number of steps (L=nz*dz)"
	    Value		    "300"
	  }
	  Object {
	    $ObjectID		    33
	    Type		    "edit"
	    Name		    "lamda0"
	    Prompt		    "Center wavelength (nm)"
	    Value		    "1550"
	  }
	  Object {
	    $ObjectID		    34
	    Type		    "edit"
