        <Prompt>Dispersion coefficient (ps/nm.km)</Prompt>
        <Value>17</Value>
      </MaskParameter>
      <MaskParameter Name="n2" Type="edit">
        <Prompt>Nonlinear refractive index (m^2/W)</Prompt>
        <Value>2.6e-20</Value>
      </MaskParameter>
      <MaskParameter Name="Aeff" Type="edit">
        <Prompt>Effective area (m^2)</Prompt>
        <Value>43.33e-12</Value>
      </MaskParameter>
      <MaskParameter Name="maxiter" Type="edit">
