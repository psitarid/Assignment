        <Value>4</Value>
      </MaskParameter>
      <MaskParameter Name="tol" Type="edit">
        <Prompt>Convergence tolerance (default=1e-5)</Prompt>
        <Value>1e-5</Value>
      </MaskParameter>
      <MaskParameter Name="P_non_thres" Type="edit">
        <Prompt>Nonlinear threshold (W)</Prompt>
        <Value>1.005</Value>
      </MaskParameter>
    </Mask>
    <System Ref="system_357"/>
  </Block>
