%=============================================
% Ορισμός χρονικού παραθύρου
%=============================================
t_max = 200;
dt = (2*t_max/2^10); % ορισμός χρονικού βήματος έτσι ώστε το μέγεθος του παλμού εισόδου να είναι δύναμη του 2 t_max:dt:(t_max-dt));
%=============================================
% Oρισμός σήματος εισόδου (ένταση πεδίου) - Gaussian παλμός
%=============================================
 P0 = 0.25;% [W] Ισχύς κορυφής
C = 0;       % Παράμετρος chirping
t0=50 ; % [psec] Κέντρο του παλμού
Tfwhm =10; % [psec] Αρχικό εύρος μισής ισχύος του παλμού
T0 = Tfwhm/(2*(log(2))^0.5); % Σημείο 1/e της ισχύος κορυφής
%================================
% Πεδίο εισόδου στο πεδίο του χρόνου
%================================
t=t_max:dt:(t_max-dt);
u0= sqrt(P0)*exp(-0.5*(1+j*C)*(((t-t0).^2./T0^2)));
