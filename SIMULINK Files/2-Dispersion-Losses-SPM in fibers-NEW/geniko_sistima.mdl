	    Value		    "1024"
	  }
	  Object {
	    $ObjectID		    42
	    Type		    "edit"
	    Name		    "dt"
	    Prompt		    "Time step (ps)"
	    Value		    "(1/fc)*10^12"
	  }
	  Object {
	    $ObjectID		    43
	    Type		    "edit"
	    Name		    "dz"
	    Prompt		    "Distance step (km)"
	    Value		    "0.01"
	  }
	  Object {
	    $ObjectID		    44
	    Type		    "edit"
	    Name		    "nz"
	    Prompt		    "Number of steps (L=nz*dz)"
	    Value		    "5000000"
	  }
	  Object {
	    $ObjectID		    45
	    Type		    "edit"
	    Name		    "lamda0"
	    Prompt		    "Center wavelength (nm)"
	    Value		    "1550"
	  }
	  Object {
	    $ObjectID		    46
	    Type		    "edit"
	    Name		    "alpha_indB"
	    Prompt		    "Power loss coefficient (dB/km)"
	    Value		    "0"
	  }
	  Object {
	    $ObjectID		    47
	    Type		    "edit"
	    Name		    "D"
	    Prompt		    "Dispersion coefficient (ps/nm.km)"
	    Value		    "17"
	  }
	  Object {
	    $ObjectID		    48
	    Type		    "edit"
	    Name		    "n2"
	    Prompt		    "Nonlinear refractive index (m^2/W)"
	    Value		    "0"
	  }
	  Object {
	    $ObjectID		    49
	    Type		    "edit"
	    Name		    "Aeff"
	    Prompt		    "Effective area (m^2)"
	    Value		    "43.33e-12"
	  }
	  Object {
